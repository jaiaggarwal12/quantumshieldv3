# ── QuantumShield Environment Variables ──────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# REQUIRED — used to sign JWT tokens. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
TOKEN_EXPIRE_MINUTES=480

# CORS — comma-separated allowed frontend origins for production, e.g.
#   https://app.example.com,https://admin.example.com
# Leave as * only for local development (credentials are disabled with wildcard).
ALLOWED_ORIGINS=*

# Database — local SQLite by default; use a PostgreSQL URL in production.
DATABASE_URL=sqlite:///./quantumshield.db

# Scan target policy (SSRF protection).
# false (default) blocks private/loopback/link-local/metadata targets.
# Set true ONLY for trusted internal deployments scanning your own infra.
ALLOW_PRIVATE_TARGETS=false
MAX_TARGETS_PER_SCAN=20

# Rate limiting
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
OTP_SEND_MAX=5
OTP_SEND_WINDOW_SECONDS=600

# Logging
LOG_LEVEL=INFO

# AI — Google Gemini (free at aistudio.google.com)
# The app tries this model first, then falls back across other free models on
# 503/429 errors, so AI stays responsive even when one model is overloaded.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Public demo account ──────────────────────────────────────────────────────
# A real, fully-working account that skips the email-OTP step so anyone can try
# the deployed app instantly. Its credentials are shown on the login page.
DEMO_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo12345
DEMO_EMAIL=demo@quantumshield.app
DEMO_ROLE=Operator

# ── Seed users (created on first boot if the users table is empty) ───────────
# Use strong, unique passwords. These are only the initial bootstrap accounts.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-strong

OPERATOR_USERNAME=operator
OPERATOR_EMAIL=operator@yourcompany.com
OPERATOR_PASSWORD=change-me-strong

CHECKER_USERNAME=auditor
CHECKER_EMAIL=auditor@yourcompany.com
CHECKER_PASSWORD=change-me-strong

# ── Email OTP (required for login — OTP is emailed to the user) ──────────────
# Gmail App Password: enable 2-Step Verification, then create an App Password
# for "Mail" at myaccount.google.com/apppasswords (16 chars, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=QuantumShield Security
